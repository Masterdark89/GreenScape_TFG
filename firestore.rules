rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas de desarrollo acotadas por colección.
    // Mantienen la app funcionando sin Firebase Auth, pero evitan exponer
    // colecciones no usadas por el cliente.

    match /routes/{routeId} {
      allow read, write: if true;
    }

    match /inventory_items/{itemId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /client_reservations/{reservationId} {
      allow read, write: if true;
    }

    match /chat_conversations/{conversationId} {
      allow read, write: if true;
    }

    match /chat_messages/{messageId} {
      allow read, write: if true;
    }

    // Utilizada por seeders y contadores internos (ids autoincrementales).
    match /metadata/{docId} {
      allow read, write: if true;
    }

    // Bloquea cualquier colección no declarada arriba.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
